<!--
  Starting point for components/AppSidebar.vue (rename, drop the .template suffix).
  Replace NAV_ITEMS with the app's real routes and label sources (i18n keys if the app has i18n).
  Place the existing language switcher / profile components in the footer slot.
-->
<template>
  <aside class="sidebar" :class="{ open }">
    <div class="sidebar-brand">
      <span class="brand-name">{{ brand }}</span>
      <span v-if="subtitle" class="brand-subtitle">{{ subtitle }}</span>
    </div>

    <nav class="sidebar-nav" aria-label="Main">
      <router-link
        v-for="item in items"
        :key="item.to"
        :to="item.to"
        class="nav-item"
        :aria-current="isActive(item.to) ? 'page' : undefined"
        :class="{ active: isActive(item.to) }"
        @click="$emit('close')"
      >
        <span class="nav-label">{{ item.label }}</span>
      </router-link>
    </nav>

    <div class="sidebar-footer">
      <slot name="footer" />
    </div>
  </aside>
  <div v-if="open" class="sidebar-backdrop" @click="$emit('close')"></div>
</template>

<script>
import { onMounted, onUnmounted } from 'vue'
import { useRoute } from 'vue-router'

export default {
  name: 'AppSidebar',
  props: {
    open: { type: Boolean, default: false },
    brand: { type: String, required: true },
    subtitle: { type: String, default: '' },
    // [{ to: '/', label: 'Overview' }, ...]
    items: { type: Array, required: true }
  },
  emits: ['close'],
  setup(props, { emit }) {
    const route = useRoute()

    // '/' must match exactly, otherwise it is active on every route
    const isActive = (to) => (to === '/' ? route.path === '/' : route.path.startsWith(to))

    const onKeydown = (e) => {
      if (e.key === 'Escape' && props.open) emit('close')
    }
    onMounted(() => window.addEventListener('keydown', onKeydown))
    onUnmounted(() => window.removeEventListener('keydown', onKeydown))

    return { isActive }
  }
}
</script>

